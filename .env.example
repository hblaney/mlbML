NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
MLB_STATS_API_BASE=https://statsapi.mlb.com/api/v1
# Optional paid odds (set ODDS_USE_ODDSAPI=1 to prefer when you have credits)
ODDS_API_KEY=
ODDS_USE_ODDSAPI=
ODDS_REGIONS=us
ODDS_MARKETS=h2h
# Free odds sources used by default (no key required):
# Action Network scoreboard, The Odds Gap lineshop, ESPN/DraftKings fallback
ODDS_SKIP_ACTIONNETWORK=
ODDS_SKIP_ODDSGAP=
ODDS_SKIP_ESPN=
MLB_WEBCAST_EMBED_BASE=https://mlbwebcast.com/stream
# Optional HTTP proxy prefix for MLB Webcast fetches on deployed hosts.
# Example: https://your-proxy.example.com/fetch?url=
STREAM_FETCH_PROXY=
